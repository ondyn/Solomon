###############################################################################
# Solomon - NetBox Docker Environment Variables
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Then generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
###############################################################################

# ─── NetBox Version ─────────────────────────────────────────────────────────
# Docker image tag from https://hub.docker.com/r/netboxcommunity/netbox/tags
NETBOX_VERSION=v4.5.5

# ─── NetBox Port (host:container mapped in docker-compose) ──────────────────
NETBOX_PORT=8000

# ─── NetBox startup grace period (increase on first run / slow machines) ────
NETBOX_START_PERIOD=120s

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=CHANGE_ME_postgres_password

# ─── Redis (task queue) ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_INSECURE_SKIP_TLS_VERIFY=false

# ─── Redis (cache) ─────────────────────────────────────────────────────────
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD=CHANGE_ME_redis_cache_password
REDIS_CACHE_DATABASE=1
REDIS_CACHE_SSL=false
REDIS_CACHE_INSECURE_SKIP_TLS_VERIFY=false

# ─── NetBox Secrets ─────────────────────────────────────────────────────────
# IMPORTANT: Generate unique values for production!
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_key_at_least_50_chars
API_TOKEN_PEPPER_1=CHANGE_ME_generate_a_random_pepper

# ─── Superuser (set SKIP_SUPERUSER=false to create on first boot) ──────────
SKIP_SUPERUSER=false
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=CHANGE_ME_admin_password
SUPERUSER_API_TOKEN=

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN_ALLOW_ALL=True

# ─── Web Server ─────────────────────────────────────────────────────────────
GRANIAN_WORKERS=2
GRANIAN_BACKPRESSURE=2

# ─── Features ──────────────────────────────────────────────────────────────
GRAPHQL_ENABLED=true
METRICS_ENABLED=false
WEBHOOKS_ENABLED=true
MEDIA_ROOT=/opt/netbox/netbox/media

# ─── Email (optional) ──────────────────────────────────────────────────────
EMAIL_SERVER=localhost
EMAIL_PORT=25
EMAIL_USERNAME=netbox
EMAIL_PASSWORD=
EMAIL_FROM=netbox@example.com
EMAIL_USE_SSL=false
EMAIL_USE_TLS=false
EMAIL_SSL_CERTFILE=
EMAIL_SSL_KEYFILE=
EMAIL_TIMEOUT=5

# ─── Misc ──────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=*
DEBUG=false
RELEASE_CHECK_URL=https://api.github.com/repos/netbox-community/netbox/releases
TIME_ZONE=Europe/Prague

# ─── Plugin Development ────────────────────────────────────────────────────
# Enable debugpy remote debugging (VS Code attach on port 5678)
DEBUGPY_ENABLE=false
DEBUGPY_PORT=5678

# ─── Solomon app settings (not used by NetBox) ─────────────────────────────
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-INSECURE
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=cs
APP_VERSION=0.1.0
CUZK_API_KEY=
