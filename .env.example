# Solomon — Environment Variables
# Copy this file to .env and fill in the values
# Never commit .env to git!
#
# NOTE: When running with Docker (make up), these values are OVERRIDDEN
# by the environment variables defined in docker-compose.yml.
# This file is mainly used as documentation and for non-Docker setups.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=solomon.settings.dev

# Database — Docker default (matches docker-compose.yml)
DATABASE_URL=postgres://solomon:solomon_dev@localhost:5432/solomon

# Email (for notifications — optional in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Localization
LANGUAGE_CODE=cs
TIME_ZONE=Europe/Prague

# App version (set by CI/CD or manually)
APP_VERSION=0.1.0

# CUZK API (Czech Cadastral Office)
# Get your API key from: https://cuzk.gov.cz
CUZK_API_KEY=
