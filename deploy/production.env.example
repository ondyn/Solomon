# Copy to deploy/production.env and replace every example value.
DOMAIN=solomon.example.cz
ACME_EMAIL=admin@example.cz
ALLOWED_HOSTS=solomon.example.cz
TIME_ZONE=Europe/Prague
DEFAULT_LANGUAGE=cs
DB_NAME=netbox
DB_USER=netbox
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
REDIS_HOST=redis
REDIS_CACHE_HOST=redis-cache
REDIS_PORT=6379
SKIP_SUPERUSER=true
DEBUG=false
DEVELOPER=false
GRANIAN_WORKERS=1
GRANIAN_BACKPRESSURE=8